font-family = Inconsolata Nerd Font Mono
font-size = 12
background-opacity = 0.9
gtk-titlebar = false
resize-overlay = never
confirm-close-surface = false
window-padding-x = 4
window-padding-y = 4
window-vsync = true
window-decoration = none
background-blur = false
command = bash -c "source ~/.config/shell/palette.sh && fastfetch && exec bash"
keybind = alt+c=write_screen_file:open

